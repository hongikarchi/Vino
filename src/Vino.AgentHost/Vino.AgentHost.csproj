<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Vino.AgentHost</AssemblyName>
    <RootNamespace>Vino.AgentHost</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vino.BridgeContract\Vino.BridgeContract.csproj" />
    <ProjectReference Include="..\Vino.CanvasAdapter\Vino.CanvasAdapter.csproj" />
    <ProjectReference Include="..\Vino.RhinoSceneAdapter\Vino.RhinoSceneAdapter.csproj" />
    <ProjectReference Include="..\Vino.Contracts\Vino.Contracts.csproj" />
    <ProjectReference Include="..\Vino.Core\Vino.Core.csproj" />
    <ProjectReference Include="..\Vino.History\Vino.History.csproj" />
    <ProjectReference Include="..\Vino.ScriptAdapter\Vino.ScriptAdapter.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vino.AgentHost.Tests" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\ui\panel\dist')">
    <Content Include="..\..\ui\panel\dist\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\skills\**\*"
             Link="skills\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\instructions\**\*"
             Link="instructions\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- The same files again, baked into the assembly: the fallback copy InstructionAssets serves
         when the deployed loose file is missing or unreadable. The build embeds from the single
         source file, so the fallback cannot drift from the asset. -->
    <EmbeddedResource Include="..\..\assets\instructions\house-rules.md"
                      LogicalName="Vino.AgentHost.Instructions.house-rules.md" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\data\**\*"
             Link="data\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
