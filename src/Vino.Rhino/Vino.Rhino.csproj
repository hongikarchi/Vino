<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <AssemblyTitle>Vino</AssemblyTitle>
    <UseSystemDrawing>true</UseSystemDrawing>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Description>Rhino 8 per-document panel and process bridge for Vino.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RhinoCommon" />
  </ItemGroup>
  <ItemGroup>
    <!-- Cream-stroke variant on purpose: Rhino's panel tab rail is dark, and the ink-stroke icon
     that suits the light GH ribbon and the Yak listing disappears on it. -->
<EmbeddedResource Include="..\..\assets\icons\vino-48-panel.png" Link="EmbeddedResources\vino-48-panel.png" LogicalName="Vino.Rhino.PanelIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Vino.BridgeContract/Vino.BridgeContract.csproj" />
    <ProjectReference Include="../Vino.RhinoSceneAdapter/Vino.RhinoSceneAdapter.csproj" />
  </ItemGroup>
</Project>
