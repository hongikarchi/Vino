auth.json
# Mirrors the package guard's $forbiddenNames (scripts/build-package.ps1): the Claude backend
# writes a per-thread mcp.json carrying a live X-Vino-Secret, and the CLI stores subscription
# OAuth material in .credentials.json / .claude.json. Today the runtime tree only ever lands
# under artifacts/, so the blanket rule already covers them — this makes the protection survive
# a relocated data directory instead of depending on one path staying put.
mcp.json
.credentials.json
.claude.json
.vino-instance.lock
*.db
*.db-shm
*.db-wal
*.secret
*.3dm
# `*.3dm` does not match these extension variants — a `git add .` would otherwise
# commit a 450 MB backup or a lock file (both were exposed in the working tree).
*.3dmbak
*.3dm.rhl
*.rhl
*.gh
*.ghx
*.yak
*.rhp
*.gha
*.log
.cache/
coverage/
*.tsbuildinfo
example/
